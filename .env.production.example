# ==============================================================================
# İLLURÊ FRAGRANCE - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.production on the production VPS (/opt/illure/.env.production).
# DO NOT COMMIT REAL .env.production OR PRODUCTION SECRETS TO GIT.
# ==============================================================================

# 1. PRODUCTION DOMAIN & TRAEFIK CONFIGURATION
# Set to the official production domain (e.g. illurefragrance.com or shop.illurefragrance.com)
PRODUCTION_DOMAIN=illurefragrance.com
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_NETWORK=kp-proxy

# 2. PRODUCTION POSTGRESQL DATABASE CREDENTIALS (NEW UNIQUE PRODUCTION SECRETS)
# Generate a strong, fresh password: openssl rand -base64 32
POSTGRES_USER=illure_prod_user
POSTGRES_PASSWORD=GENERATE_NEW_PRODUCTION_POSTGRES_PASSWORD
POSTGRES_DB=illure_prod_db

# 3. JWT AUTHENTICATION SECRETS (NEW UNIQUE PRODUCTION SECRETS)
# Generate 64-character hex strings: openssl rand -hex 32
JWT_ACCESS_SECRET=GENERATE_NEW_UNIQUE_JWT_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=GENERATE_NEW_UNIQUE_JWT_REFRESH_SECRET_MIN_32_CHARS
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# 4. CORS & COOKIE CONFIGURATION
FRONTEND_URL=https://illurefragrance.com
COOKIE_DOMAIN=.illurefragrance.com
LOG_LEVEL=info

# 5. INITIAL PRODUCTION SUPER ADMIN CREDENTIALS (SEPARATE FROM STAGING)
# Must use client's official admin email and a strong distinct password
SEED_ADMIN_EMAIL=admin@illurefragrance.com
SEED_ADMIN_PASSWORD=GENERATE_NEW_UNIQUE_STRONG_ADMIN_PASSWORD
SEED_ADMIN_NAME=Illure Super Admin

# 6. RAZORPAY PAYMENT GATEWAY (LIVE CREDENTIALS FOR PRODUCTION)
# Use real live keys: rzp_live_...
RAZORPAY_KEY_ID=rzp_live_YOUR_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=GENERATE_NEW_PRODUCTION_WEBHOOK_SECRET

# 7. SMTP EMAIL DISPATCH CONFIGURATION (PRODUCTION TRANSACTIONAL EMAIL)
# E.g. Amazon SES, Postmark, SendGrid, or Google Workspace SMTP Relay
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=YOUR_PRODUCTION_SMTP_API_KEY
SMTP_FROM_NAME=İLLURÊ FRAGRANCE
SMTP_FROM_EMAIL=concierge@illurefragrance.com
ORDER_NOTIFICATION_EMAIL=orders@illurefragrance.com
