# Server Environment Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://illure:illure_password@localhost:5437/illure_db?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_32_chars

# Token Lifespans (e.g. 15m, 7d)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Frontend CORS Origin
FRONTEND_URL=http://localhost:5173

# Optional Configuration
COOKIE_DOMAIN=localhost
LOG_LEVEL=info

# Initial Super Admin Seeding Credentials
SEED_ADMIN_EMAIL=admin@illurefragrance.com
SEED_ADMIN_PASSWORD=SuperAdmin@Illure2026!
SEED_ADMIN_NAME=Illure Admin
