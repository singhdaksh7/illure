generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  ORDER_MANAGER
  INVENTORY_MANAGER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum InventoryMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  CANCELLATION
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  COD_PENDING
}

enum PaymentProvider {
  RAZORPAY
  COD
}

enum CouponType {
  PERCENTAGE
  FIXED
}

// ==========================================
// ADMIN MODELS
// ==========================================

model AdminUser {
  id                        String               @id @default(uuid())
  email                     String               @unique
  passwordHash              String
  name                      String
  role                      AdminRole            @default(ADMIN)
  isActive                  Boolean              @default(true)
  lastLoginAt               DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  sessions                  AdminSession[]
  createdInventoryMovements InventoryMovement[]
  statusHistories           OrderStatusHistory[]

  @@map("admin_users")
}

model AdminSession {
  id               String    @id @default(uuid())
  adminUserId      String
  adminUser        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  ipAddress        String?
  userAgent        String?

  @@index([adminUserId])
  @@index([refreshTokenHash])
  @@map("admin_sessions")
}

// ==========================================
// PRODUCT CATALOG MODELS
// ==========================================

model ReferenceBrand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("reference_brands")
}

model Category {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  description       String?
  imageUrl          String?
  isActive          Boolean           @default(true)
  sortOrder         Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  productCategories ProductCategory[]

  @@map("categories")
}

model Product {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  shortDescription  String?
  description       String
  referenceBrandId  String?
  referenceBrand    ReferenceBrand?   @relation(fields: [referenceBrandId], references: [id], onDelete: SetNull)
  inspiredByName    String?
  gender            Gender            @default(UNISEX)
  fragranceFamily   String?
  topNotes          String[]          @default([])
  heartNotes        String[]          @default([])
  baseNotes         String[]          @default([])
  occasion          String?
  season            String?
  longevity         String?
  projection        String?
  featured          Boolean           @default(false)
  bestseller        Boolean           @default(false)
  newArrival        Boolean           @default(false)
  status            ProductStatus     @default(ACTIVE)
  seoTitle          String?
  seoDescription   String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  variants          ProductVariant[]
  images            ProductImage[]
  productCategories ProductCategory[]
  orderItems        OrderItem[]
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  discoveryEligibleItems DiscoverySetEligibleItem[]
  discoveryPrebuiltItems DiscoverySetPrebuiltItem[]
  reviews                ProductReview[]

  @@index([referenceBrandId])
  @@index([status])
  @@index([gender])
  @@map("products")
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id                 String              @id @default(uuid())
  productId          String
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeLabel          String
  sizeMl             Decimal?            @db.Decimal(8, 2)
  sku                String              @unique
  price              Decimal             @db.Decimal(10, 2)
  compareAtPrice     Decimal?            @db.Decimal(10, 2)
  costPrice          Decimal?            @db.Decimal(10, 2)
  stockQuantity      Int                 @default(0)
  lowStockThreshold  Int                 @default(5)
  isActive           Boolean             @default(true)
  sortOrder          Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  cartItems          CartItem[]
  stockAlerts        StockAlertSubscription[]
  discoveryEligibleItems DiscoverySetEligibleItem[]
  discoveryPrebuiltItems DiscoverySetPrebuiltItem[]
  reviews                ProductReview[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  storageKey String?
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

model GiftPackaging {
  id          String     @id @default(uuid())
  name        String
  description String?
  price       Decimal    @db.Decimal(10, 2)
  imageUrl    String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  cartItems   CartItem[]

  @@map("gift_packaging")
}

model InventoryMovement {
  id               String                @id @default(uuid())
  variantId        String
  variant          ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  type             InventoryMovementType
  quantity         Int
  reason           String?
  reference        String?
  createdByAdminId String?
  createdByAdmin   AdminUser?            @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime              @default(now())

  @@index([variantId])
  @@index([reference])
  @@map("inventory_movements")
}

// ==========================================
// CUSTOMER & ORDER MODELS
// ==========================================

model Customer {
  id           String            @id @default(uuid())
  email        String?           @unique
  phone        String
  name         String
  passwordHash String?
  passwordResetToken String?
  passwordResetExpires DateTime?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  addresses    CustomerAddress[]
  orders       Order[]
  sessions     CustomerSession[]
  cart         Cart?
  wishlist       WishlistItem[]
  stockAlerts    StockAlertSubscription[]
  scentProfile   CustomerScentProfile?
  reviews        ProductReview[]
  giftCardsPurchased GiftCard[]   @relation("CustomerGiftCards")
  loyaltyAccount LoyaltyAccount?
  referralsMade  Referral[]       @relation("ReferrerCust")
  referredBy     Referral?        @relation("ReferredCust")
  returnRequests OrderReturnRequest[]

  @@index([phone])
  @@map("customers")
}

model CustomerSession {
  id               String    @id @default(uuid())
  customerId       String
  customer         Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  ipAddress        String?
  userAgent        String?

  @@index([customerId])
  @@index([refreshTokenHash])
  @@map("customer_sessions")
}

model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
  @@map("customer_addresses")
}

model Cart {
  id         String     @id @default(uuid())
  customerId String?    @unique
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessionKey String?    @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      CartItem[]

  @@index([customerId])
  @@index([sessionKey])
  @@map("carts")
}

model CartItem {
  id              String         @id @default(uuid())
  cartId          String
  cart            Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId       String
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity        Int            @default(1)
  giftPackagingId String?
  giftPackaging   GiftPackaging? @relation(fields: [giftPackagingId], references: [id], onDelete: SetNull)
  giftMessage     String?
  bundleConfigId  String?
  bundleConfig    DiscoverySetConfig? @relation(fields: [bundleConfigId], references: [id], onDelete: SetNull)
  bundleSelections Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_items")
}

model Order {
  id                  String               @id @default(uuid())
  orderNumber         String               @unique
  customerId          String?
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status              OrderStatus          @default(PENDING)
  paymentStatus       PaymentStatus        @default(PENDING)
  subtotal            Decimal              @db.Decimal(10, 2)
  discountAmount      Decimal              @default(0.00) @db.Decimal(10, 2)
  shippingAmount      Decimal              @default(0.00) @db.Decimal(10, 2)
  giftPackagingAmount Decimal              @default(0.00) @db.Decimal(10, 2)
  taxAmount           Decimal              @default(0.00) @db.Decimal(10, 2)
  totalAmount         Decimal              @db.Decimal(10, 2)
  customerName        String
  customerPhone       String
  customerEmail       String?
  couponCode          String?
  couponId            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  items               OrderItem[]
  shippingAddress     OrderAddress?
  statusHistory       OrderStatusHistory[]
  payments            Payment[]
  returnRequests      OrderReturnRequest[]
  shipments           Shipment[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName        String
  inspiredByName     String?
  sizeLabel          String
  sku                String
  unitPrice          Decimal         @db.Decimal(10, 2)
  quantity           Int
  lineTotal          Decimal         @db.Decimal(10, 2)
  giftPackagingName  String?
  giftPackagingPrice Decimal?        @db.Decimal(10, 2)
  giftMessage        String?
  bundleConfigId     String?
  bundleConfig       DiscoverySetConfig? @relation(fields: [bundleConfigId], references: [id], onDelete: SetNull)
  bundleSelections   Json?

  @@index([orderId])
  @@map("order_items")
}

model OrderAddress {
  id           String  @id @default(uuid())
  orderId      String  @unique
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  addressLine1 String
  addressLine2 String?
  landmark     String?
  city         String
  state        String
  postalCode   String

  @@map("order_addresses")
}

model OrderStatusHistory {
  id               String      @id @default(uuid())
  orderId          String
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  oldStatus        OrderStatus
  newStatus        OrderStatus
  changedByAdminId String?
  changedByAdmin   AdminUser?  @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)
  note             String?
  createdAt        DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model Payment {
  id                String          @id @default(uuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          PaymentProvider
  method            String?
  providerOrderId   String?         @unique
  providerPaymentId String?         @unique
  providerSignature String?
  amount            Decimal         @db.Decimal(10, 2)
  currency          String          @default("INR")
  status            PaymentStatus   @default(PENDING)
  failureCode       String?
  failureReason     String?
  rawPayload        String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId])
  @@map("payments")
}

model ProcessedWebhookEvent {
  id          String          @id @default(uuid())
  eventId     String          @unique
  provider    PaymentProvider
  eventType   String
  processedAt DateTime        @default(now())

  @@map("processed_webhook_events")
}

model ShippingSetting {
  id                    String   @id @default(uuid())
  flatRate              Decimal  @default(99.00) @db.Decimal(10, 2)
  freeShippingThreshold Decimal  @default(999.00) @db.Decimal(10, 2)
  isEnabled             Boolean  @default(true)
  updatedAt             DateTime @updatedAt

  @@map("shipping_settings")
}

model Coupon {
  id                    String     @id @default(uuid())
  code                  String     @unique
  type                  CouponType
  value                 Decimal    @db.Decimal(10, 2)
  minimumOrderAmount    Decimal?   @db.Decimal(10, 2)
  maximumDiscountAmount Decimal?   @db.Decimal(10, 2)
  startsAt              DateTime?
  expiresAt             DateTime?
  usageLimit            Int?
  usageCount            Int        @default(0)
  isActive              Boolean    @default(true)
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  @@map("coupons")
}

// ==========================================
// CMS & SITE SETTINGS
// ==========================================

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model HomepageSection {
  id            String   @id @default(uuid())
  sectionKey    String   @unique
  name          String
  isEnabled     Boolean  @default(true)
  sortOrder     Int      @default(0)
  layoutVariant String   @default("DEFAULT")
  title         String?
  subtitle      String?
  description   String?
  ctaLabel      String?
  ctaUrl        String?
  desktopImage  String?
  mobileImage   String?
  customData    Json?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sortOrder])
  @@index([isEnabled])
  @@map("homepage_sections")
}

// ==========================================
// COMMERCE FEATURES ARCHITECTURE (PHASE 1)
// ==========================================

enum FeatureGroup {
  DISCOVERY
  CONVERSION
  GIFTING
  RETENTION
  LOYALTY
  ORDERS
  DELIVERY
  MARKETING
  ANALYTICS
  CUSTOMER_EXPERIENCE
}

enum FeatureStatus {
  DISABLED
  DRAFT
  ACTIVE
  SCHEDULED
  CONFIGURATION_REQUIRED
}

model CommerceFeature {
  id                  String        @id @default(uuid())
  key                 String        @unique
  name                String
  description         String
  group               FeatureGroup
  isEnabled           Boolean       @default(false)
  status              FeatureStatus @default(DISABLED)
  showInNavigation    Boolean       @default(false)
  navigationLabel     String?
  navigationPath      String?
  showOnHomepage      Boolean       @default(false)
  homepageSortOrder   Int           @default(0)
  config              Json          @default("{}")
  minimumOrderValue   Decimal?      @db.Decimal(10, 2)
  maximumOrderValue   Decimal?      @db.Decimal(10, 2)
  startAt             DateTime?
  endAt               DateTime?
  sortOrder           Int           @default(0)
  updatedBy           String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  auditLogs           CommerceAuditLog[]

  @@index([group])
  @@index([isEnabled])
  @@index([status])
  @@map("commerce_features")
}

model CommerceAuditLog {
  id          String           @id @default(uuid())
  featureId   String?
  featureKey  String?
  actorId     String?
  actorName   String?
  actorRole   String?
  action      String           // e.g. "TOGGLE_ENABLED", "UPDATE_CONFIG", "CHANGE_STATUS"
  oldValue    Json?
  newValue    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime         @default(now())

  feature     CommerceFeature? @relation(fields: [featureId], references: [id], onDelete: SetNull)

  @@index([featureKey])
  @@index([actorId])
  @@index([createdAt])
  @@map("commerce_audit_logs")
}

model CommerceEventLog {
  id          String   @id @default(uuid())
  eventType   String   // e.g. "SCENT_FINDER_STARTED", "WISHLIST_ADDED"
  featureKey  String?
  customerId  String?
  sessionId   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([eventType])
  @@index([featureKey])
  @@index([customerId])
  @@index([createdAt])
  @@map("commerce_event_logs")
}

// ==========================================
// PHASE 3: CONVERSION MODELS
// ==========================================

enum DiscoverySetType {
  CUSTOM
  PREBUILT
}

enum DiscoverySetSelectionMode {
  PRODUCT
  VARIANT
}

enum DiscoverySetPricingMode {
  FIXED
  SUM
  DISCOUNTED_SUM
}

enum DiscoverySetStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model DiscoverySetConfig {
  id              String                    @id @default(uuid())
  name            String
  slug            String                    @unique
  type            DiscoverySetType          @default(CUSTOM)
  status          DiscoverySetStatus        @default(ACTIVE)
  title           String
  subtitle        String?
  description     String?
  imageUrl        String?
  selectionMode   DiscoverySetSelectionMode @default(PRODUCT)
  minSelections   Int                       @default(3)
  maxSelections   Int                       @default(3)
  pricingMode     DiscoverySetPricingMode   @default(FIXED)
  fixedPrice      Decimal?                  @db.Decimal(10, 2)
  discountPercent Decimal?                  @db.Decimal(5, 2)
  allowDuplicates Boolean                   @default(false)
  maxPerOrder     Int                       @default(5)
  startsAt        DateTime?
  endsAt          DateTime?
  sortOrder       Int                       @default(0)
  isFeatured      Boolean                   @default(false)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  eligibleItems   DiscoverySetEligibleItem[]
  prebuiltItems   DiscoverySetPrebuiltItem[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([slug])
  @@index([status])
  @@index([type])
  @@map("discovery_set_configs")
}

model DiscoverySetEligibleItem {
  id              String              @id @default(uuid())
  discoverySetId  String
  discoverySet    DiscoverySetConfig  @relation(fields: [discoverySetId], references: [id], onDelete: Cascade)
  productId       String
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())

  @@unique([discoverySetId, productId, variantId])
  @@index([discoverySetId])
  @@index([productId])
  @@map("discovery_set_eligible_items")
}

model DiscoverySetPrebuiltItem {
  id              String              @id @default(uuid())
  discoverySetId  String
  discoverySet    DiscoverySetConfig  @relation(fields: [discoverySetId], references: [id], onDelete: Cascade)
  productId       String
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity        Int                 @default(1)
  sortOrder       Int                 @default(0)
  createdAt       DateTime            @default(now())

  @@unique([discoverySetId, productId, variantId])
  @@index([discoverySetId])
  @@index([productId])
  @@map("discovery_set_prebuilt_items")
}

model WishlistItem {
  id          String    @id @default(uuid())
  customerId  String
  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
  @@map("wishlist_items")
}

enum StockAlertStatus {
  ACTIVE
  SENT
  CANCELLED
}

model StockAlertSubscription {
  id               String           @id @default(uuid())
  productVariantId String
  variant          ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  customerId       String?
  customer         Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email            String
  status           StockAlertStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  sentAt           DateTime?

  @@unique([productVariantId, email, status])
  @@index([productVariantId])
  @@index([email])
  @@index([status])
  @@map("stock_alert_subscriptions")
}



// ==========================================
// PHASE 3H: ASYNC NOTIFICATION JOBS
// ==========================================
enum NotificationJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model NotificationJob {
  id            String                @id @default(uuid())
  type          String                // STOCK_ALERT, ABANDONED_CART, REVIEW_REQUEST, etc.
  status        NotificationJobStatus @default(PENDING)
  payload       Json
  attempts      Int                   @default(0)
  maxAttempts   Int                   @default(3)
  nextAttemptAt DateTime?             @default(now())
  lastError     String?
  processedAt   DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status, nextAttemptAt])
  @@index([type])
  @@map("notification_jobs")
}

// ==========================================
// PHASE 4: GIFTING & GIFT CARDS
// ==========================================
enum GiftCardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

model GiftCard {
  id                    String         @id @default(uuid())
  code                  String         @unique
  initialBalance        Decimal        @db.Decimal(10, 2)
  currentBalance        Decimal        @db.Decimal(10, 2)
  currency              String         @default("INR")
  status                GiftCardStatus @default(ACTIVE)
  recipientEmail        String?
  recipientName         String?
  senderName            String?
  message               String?
  purchasedByCustomerId String?
  purchasedByCustomer   Customer?      @relation("CustomerGiftCards", fields: [purchasedByCustomerId], references: [id], onDelete: SetNull)
  expiresAt             DateTime?
  redeemedAt            DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([code])
  @@index([status])
  @@map("gift_cards")
}

// ==========================================
// PHASE 5: RETENTION & REVIEWS
// ==========================================
model CustomerScentProfile {
  id                String    @id @default(uuid())
  customerId        String    @unique
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  preferredFamilies String[]  @default([])
  likedNotes        String[]  @default([])
  avoidedNotes      String[]  @default([])
  moods             String[]  @default([])
  occasions         String[]  @default([])
  intensity         String?
  quizAnswers       Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("customer_scent_profiles")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ProductReview {
  id              String          @id @default(uuid())
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId         String?
  rating          Int          // 1-5
  scentRating     Int?         // 1-5
  longevityRating Int?         // 1-5
  valueRating     Int?         // 1-5
  wouldBuyAgain   Boolean?     @default(true)
  title           String?
  comment         String
  mediaUrls       String[]     @default([])
  isVerified      Boolean      @default(false)
  status          ReviewStatus @default(PENDING)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([productId, status])
  @@index([customerId])
  @@map("product_reviews")
}

// ==========================================
// PHASE 6: LOYALTY & REFERRALS & DROPS
// ==========================================
model LoyaltyAccount {
  id           String               @id @default(uuid())
  customerId   String               @unique
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  balance      Int                  @default(0)
  tier         String               @default("OBSIDIAN") // BRONZE, SILVER, GOLD, OBSIDIAN
  transactions LoyaltyTransaction[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@map("loyalty_accounts")
}

enum LoyaltyTxType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

model LoyaltyTransaction {
  id        String         @id @default(uuid())
  accountId String
  account   LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type      LoyaltyTxType
  points    Int
  orderId   String?
  reason    String
  createdAt DateTime       @default(now())

  @@index([accountId])
  @@index([orderId])
  @@map("loyalty_transactions")
}

model Referral {
  id            String    @id @default(uuid())
  referrerId    String
  referrer      Customer  @relation("ReferrerCust", fields: [referrerId], references: [id], onDelete: Cascade)
  code          String    @unique
  referredEmail String?
  referredId    String?   @unique
  referred      Customer? @relation("ReferredCust", fields: [referredId], references: [id], onDelete: SetNull)
  rewardClaimed Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@index([code])
  @@index([referrerId])
  @@map("referrals")
}

model LimitedDrop {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  title       String
  description String?
  imageUrl    String?
  startsAt    DateTime
  endsAt      DateTime?
  earlyAccess Boolean   @default(false)
  productIds  String[]  @default([])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isActive])
  @@map("limited_drops")
}

// ==========================================
// PHASE 7: OPERATIONS, RETURNS, PINCODES & RISK
// ==========================================
enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  RESOLVED
}

model OrderReturnRequest {
  id           String       @id @default(uuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items        Json         // array of { orderItemId, quantity, reason }
  reason       String
  evidenceUrls String[]     @default([])
  status       ReturnStatus @default(PENDING)
  resolution   String?
  adminNotes   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("order_return_requests")
}

model PincodeRule {
  id            String   @id @default(uuid())
  pincode       String   @unique
  isServiceable Boolean  @default(true)
  isCodAllowed  Boolean  @default(true)
  estimatedDays Int      @default(3)
  state         String?
  city          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([pincode])
  @@map("pincode_rules")
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
}

model RiskFlag {
  id         String       @id @default(uuid())
  orderId    String?
  customerId String?
  reason     String
  severity   RiskSeverity @default(MEDIUM)
  isResolved Boolean      @default(false)
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([orderId])
  @@index([customerId])
  @@index([isResolved])
  @@map("risk_flags")
}


// ==========================================
// ADMIN OPERATING SYSTEM MODELS
// ==========================================

model UrlRedirect {
  id          String   @id @default(uuid())
  sourcePath  String   @unique
  targetPath  String
  statusCode  Int      @default(301)
  isActive    Boolean  @default(true)
  hitCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sourcePath])
  @@map("url_redirects")
}

model MediaItem {
  id          String   @id @default(uuid())
  storageKey  String   @unique
  publicUrl   String
  fileName    String
  mimeType    String
  fileSize    Int
  width       Int?
  height      Int?
  altText     String?
  folder      String   @default("general")
  usedByCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storageKey])
  @@index([folder])
  @@map("media_items")
}

enum BannerPosition {
  HOMEPAGE
  CATALOG
  PDP
  CART
  ACCOUNT
}

model Banner {
  id            String         @id @default(uuid())
  name          String
  position      BannerPosition @default(HOMEPAGE)
  desktopImageUrl String
  mobileImageUrl  String?
  headline      String?
  subheadline   String?
  ctaLabel      String?
  ctaUrl        String?
  sortOrder     Int            @default(0)
  isEnabled     Boolean        @default(true)
  startAt       DateTime?
  endAt         DateTime?
  impressions   Int            @default(0)
  clicks        Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([position, isEnabled])
  @@map("banners")
}

model AnnouncementTicker {
  id            String    @id @default(uuid())
  message       String
  linkLabel     String?
  linkUrl       String?
  priority      Int       @default(0)
  isEnabled     Boolean   @default(true)
  startAt       DateTime?
  endAt         DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isEnabled])
  @@map("announcement_tickers")
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model StaticPage {
  id          String     @id @default(uuid())
  title       String
  slug        String     @unique
  content     String
  status      PageStatus @default(DRAFT)
  seoTitle    String?
  seoDescription String?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([status])
  @@map("static_pages")
}

enum IntegrationProvider {
  R2
  SHIPROCKET
  RAZORPAY
  SMTP
}

model IntegrationConfig {
  id                    String              @id @default(uuid())
  provider              IntegrationProvider @unique
  isEnabled             Boolean             @default(false)
  encryptedCredentials  String              // AES-256-GCM ciphertext
  settings              Json                @default("{}")
  lastTestedAt          DateTime?
  lastTestStatus        String?
  lastTestMessage       String?
  updatedBy             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([provider])
  @@map("integration_configs")
}

enum ShipmentStatus {
  PENDING
  READY_TO_SHIP
  MANIFESTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RTO
  CANCELLED
}

model Shipment {
  id              String         @id @default(uuid())
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String         @default("SHIPROCKET")
  providerOrderId String?
  shipmentId      String?
  awb             String?        @unique
  courierName     String?
  status          ShipmentStatus @default(PENDING)
  trackingUrl     String?
  labelUrl        String?
  manifestUrl     String?
  rawMetadata     Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([orderId])
  @@index([awb])
  @@index([status])
  @@map("shipments")
}

model WebhookLog {
  id          String   @id @default(uuid())
  provider    String   // RAZORPAY, SHIPROCKET, etc.
  eventId     String?
  eventType   String?
  payload     Json
  status      String   // PROCESSED, FAILED, IGNORED
  attempts    Int      @default(1)
  error       String?
  receivedAt  DateTime @default(now())

  @@index([provider, eventId])
  @@index([status])
  @@map("webhook_logs")
}
